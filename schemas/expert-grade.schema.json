{
  "$id": "https://heuristics-layer.dev/schemas/expert-grade.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "gradeVersion": {
      "type": "string",
      "const": "0.1.0"
    },
    "caseId": {
      "type": "string",
      "minLength": 1
    },
    "outputLabel": {
      "type": "string",
      "enum": [
        "A",
        "B",
        "C"
      ]
    },
    "grader": {
      "type": "string",
      "minLength": 1
    },
    "gradedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    },
    "rubricScores": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "criterion": {
            "type": "string",
            "minLength": 1
          },
          "score": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5
          },
          "note": {
            "type": "string"
          }
        },
        "required": [
          "criterion",
          "score"
        ],
        "additionalProperties": false
      }
    },
    "overallScore": {
      "type": "number",
      "minimum": 1,
      "maximum": 5
    },
    "notes": {
      "default": "",
      "type": "string"
    }
  },
  "required": [
    "gradeVersion",
    "caseId",
    "outputLabel",
    "grader",
    "gradedAt",
    "rubricScores",
    "overallScore",
    "notes"
  ],
  "additionalProperties": false
}
