{
  "$id": "https://heuristics-layer.dev/schemas/corpus.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "formatVersion": {
      "type": "string",
      "const": "0.1.0"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    },
    "sourceHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "heuristics": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)+$"
          },
          "title": {
            "type": "string",
            "minLength": 3
          },
          "version": {
            "type": "string",
            "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-[0-9A-Za-z.-]+)?$"
          },
          "status": {
            "type": "string",
            "enum": [
              "observed",
              "candidate",
              "needs_clarification",
              "challenged",
              "approved",
              "rejected",
              "deprecated"
            ]
          },
          "kind": {
            "type": "string",
            "enum": [
              "hard_constraint",
              "soft_heuristic",
              "caution_signal",
              "probe_strategy",
              "escalation_trigger",
              "contextual_consideration"
            ]
          },
          "domains": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "category": {
            "type": "string",
            "minLength": 1
          },
          "tags": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "principle": {
            "type": "string",
            "minLength": 10
          },
          "rationale": {
            "type": "string",
            "minLength": 10
          },
          "triggers": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "signals": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "probes": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "confidenceEffect": {
            "type": "string",
            "minLength": 1
          },
          "riskEffect": {
            "type": "string",
            "minLength": 1
          },
          "decisionImplications": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "escalationConditions": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "exceptions": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "compensatingFactors": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "noviceMistake": {
            "type": "string",
            "minLength": 1
          },
          "related": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)+$"
            }
          },
          "examples": {
            "minItems": 2,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "enum": [
                    "positive",
                    "negative",
                    "edge",
                    "counterexample"
                  ]
                },
                "scenario": {
                  "type": "string",
                  "minLength": 1
                },
                "expected": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "kind",
                "scenario",
                "expected"
              ],
              "additionalProperties": false
            }
          },
          "expertConfidence": {
            "type": "object",
            "properties": {
              "level": {
                "type": "string",
                "enum": [
                  "low",
                  "medium",
                  "high"
                ]
              },
              "rationale": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "level",
              "rationale"
            ],
            "additionalProperties": false
          },
          "provenance": {
            "type": "object",
            "properties": {
              "interviewId": {
                "type": "string",
                "minLength": 1
              },
              "sourcePath": {
                "type": "string",
                "minLength": 1
              },
              "excerpts": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "observationId": {
                      "type": "string",
                      "minLength": 1
                    },
                    "quote": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "observationId",
                    "quote"
                  ],
                  "additionalProperties": false
                }
              },
              "createdAt": {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
              },
              "approvedAt": {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
              },
              "approvedBy": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "interviewId",
              "sourcePath",
              "excerpts",
              "createdAt"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "title",
          "version",
          "status",
          "kind",
          "domains",
          "category",
          "tags",
          "principle",
          "rationale",
          "triggers",
          "signals",
          "probes",
          "decisionImplications",
          "escalationConditions",
          "exceptions",
          "compensatingFactors",
          "related",
          "examples",
          "provenance"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "formatVersion",
    "generatedAt",
    "sourceHash",
    "heuristics"
  ],
  "additionalProperties": false
}
