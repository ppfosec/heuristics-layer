{
  "$id": "https://heuristics-layer.dev/schemas/reasoning-artifact.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "facts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "heuristicIds": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)+$"
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidenceConfidence": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },
    "inferences": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "uncertainty": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "openQuestions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "escalation": {
      "type": "string",
      "enum": [
        "none",
        "consider",
        "required"
      ]
    },
    "modelConfidence": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },
    "conclusion": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "facts",
    "heuristicIds",
    "evidence",
    "evidenceConfidence",
    "inferences",
    "uncertainty",
    "openQuestions",
    "escalation",
    "conclusion"
  ],
  "additionalProperties": false
}
