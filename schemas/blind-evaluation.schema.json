{
  "$id": "https://heuristics-layer.dev/schemas/blind-evaluation.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "reviewVersion": {
      "type": "string",
      "const": "0.1.0"
    },
    "caseId": {
      "type": "string",
      "minLength": 1
    },
    "task": {
      "type": "string",
      "minLength": 1
    },
    "context": {
      "type": "string",
      "minLength": 1
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "rubric": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "outputs": {
      "minItems": 3,
      "maxItems": 3,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string",
            "enum": [
              "A",
              "B",
              "C"
            ]
          },
          "artifact": {
            "type": "object",
            "properties": {
              "facts": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "heuristicIds": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)+$"
                }
              },
              "evidence": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "evidenceConfidence": {
                "type": "string",
                "enum": [
                  "low",
                  "medium",
                  "high"
                ]
              },
              "inferences": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "uncertainty": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "openQuestions": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "escalation": {
                "type": "string",
                "enum": [
                  "none",
                  "consider",
                  "required"
                ]
              },
              "modelConfidence": {
                "type": "string",
                "enum": [
                  "low",
                  "medium",
                  "high"
                ]
              },
              "conclusion": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "facts",
              "heuristicIds",
              "evidence",
              "evidenceConfidence",
              "inferences",
              "uncertainty",
              "openQuestions",
              "escalation",
              "conclusion"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "label",
          "artifact"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "reviewVersion",
    "caseId",
    "task",
    "context",
    "evidence",
    "rubric",
    "outputs"
  ],
  "additionalProperties": false
}
