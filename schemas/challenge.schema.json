{
  "$id": "https://heuristics-layer.dev/schemas/challenge.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "heuristicId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)+$"
    },
    "questions": {
      "minItems": 2,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "counterexamples": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "positive",
              "negative",
              "edge",
              "counterexample"
            ]
          },
          "scenario": {
            "type": "string",
            "minLength": 1
          },
          "expected": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "kind",
          "scenario",
          "expected"
        ],
        "additionalProperties": false
      }
    },
    "unresolved": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "proposedRevision": {
      "type": "string",
      "minLength": 10
    }
  },
  "required": [
    "heuristicId",
    "questions",
    "counterexamples",
    "unresolved"
  ],
  "additionalProperties": false
}
